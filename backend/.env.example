# PostgreSQL connection (used by database.py)
DATABASE_URL=postgresql+asyncpg://phishhunt:phishhunt_password@localhost:5432/phishhunt

# Secret used to sign auth cookies — CHANGE THIS IN PRODUCTION
JWT_SECRET=super_secret_jwt_key_for_phishhunt

# Optional: comma-separated whitelist of domains allowed for URL imports
ALLOWED_IMPORT_DOMAINS=
